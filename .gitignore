# Fresh bench runs are local. The committed evidence is listed below.
benchmarks/results/*
!benchmarks/results/.gitkeep
!benchmarks/results/BENCH.md
!benchmarks/results/BENCH_SCALE.md
!benchmarks/results/BENCH_SCALE.json
!benchmarks/results/BENCH_ADBC.md
!benchmarks/results/BENCH_ADBC.json
!benchmarks/results/latest.json
!benchmarks/results/BENCH_SCALE_QUICK.md
!benchmarks/results/BENCH_SCALE_QUICK.json
!benchmarks/results/EMULATOR_DEGRADATION.md
!benchmarks/results/EMULATOR_DEGRADATION.json
!benchmarks/results/PROFILE_LISTING*.md
!benchmarks/results/PROFILE_LISTING*.json
!benchmarks/results/PROFILE_LISTING_cprofile.txt
!benchmarks/results/CLIENT_COST.md
!benchmarks/results/CLIENT_COST.json

audits/results/*
!audits/results/PAIR_AUDIT.csv
!audits/results/PAIR_AUDIT.json
!audits/results/CAPABILITY_RANK.md
!audits/results/CAPABILITY_RANK.json

# Shim / experiment artifacts (do not commit venvs or emulator state)
shims/*/.venv/
shims/*/.airflow-home/
shims/*/pytest-*.xml
shims/*/.pytest_cache/
shims/*/parity-results.json
shims/*/wrapper-results.json
experiments/*/.venv/
experiments/*/.airflow-home/
experiments/*/pytest-*.xml
experiments/*/.pytest_cache/
experiments/*/parity-results.json
